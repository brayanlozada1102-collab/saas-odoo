        <mxCell id="kms" value="AWS KMS (Key Mgmt Service)&#xa;• Llaves CMK gestionadas por cliente&#xa;• Cifrado AES-256 en reposo (RDS, EFS, Logs)&#xa;• Rotación anual de llaves criptográficas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#B91C1C;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1640" y="845" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="aws_backup" value="AWS Backup (Plan Centralizado Diario)&#xa;• Snapshots diarios automáticos a las 02:00 AM&#xa;• Respaldo consistente de RDS PostgreSQL y EFS&#xa;• Retención: 30 días • Point-in-Time Recovery (35d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10B981;strokeColor=#047857;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="925" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cloudwatch" value="Amazon CloudWatch (Logs &amp; Métricas)&#xa;• Centralización logs de Odoo (/ecs/saas-odoo)&#xa;• Alarmas de CPU, Memoria, IOPS y Errores 5XX&#xa;• Cost Allocation Tags por TenantId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#D97706;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1640" y="925" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ecr" value="Amazon ECR (Container Registry)&#xa;• Imagen Odoo 18 con Addons corporativos&#xa;• Escaneo de vulnerabilidades continuo&#xa;• Tags semánticos de producción (v18.0.x)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#D97706;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1010" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="guardduty" value="AWS GuardDuty &amp; CloudTrail&#xa;• Detección de amenazas inteligentes&#xa;• Auditoría forense de accesos a secretos&#xa;• Cumplimiento SOC2 / ISO 27001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#B91C1C;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
