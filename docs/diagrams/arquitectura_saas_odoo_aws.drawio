        <mxCell id="secrets_mgr" value="AWS Secrets Manager&#xa;• Credenciales por Tenant cifradas con KMS&#xa;• Inyección directa a Fargate sin texto plano&#xa;• Rotación automática de contraseñas de BD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#B91C1C;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
